[Unit]
Description=Bazar Manager API (PocketBase)
After=network.target

[Service]
Type=simple
User=bazar
Group=bazar
WorkingDirectory=/opt/bazar
# BAZAR_ORIGINS = the frontend URL(s) allowed by CORS, e.g. https://bazar.vercel.app
EnvironmentFile=/opt/bazar/.env
# pb_migrations/, pb_hooks/ and pb_data/ are resolved next to the binary.
ExecStart=/opt/bazar/pocketbase serve --http=127.0.0.1:8090 --origins=${BAZAR_ORIGINS}
Restart=always
RestartSec=3
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/bazar

[Install]
WantedBy=multi-user.target
