[Unit]
Description=Bazar Manager (PocketBase: app + API)
After=network.target

[Service]
Type=simple
User=bazar
Group=bazar
WorkingDirectory=/opt/bazar
# pb_public/ (frontend), pb_migrations/, pb_hooks/ and pb_data/ are resolved next to the binary.
# App and API share one origin, so no CORS setting is needed.
# INFERHUB_* (AI assistant key, model). Optional: '-' = start without it.
EnvironmentFile=-/opt/bazar/.env
ExecStart=/opt/bazar/pocketbase serve --http=127.0.0.1:8090
Restart=always
RestartSec=3
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/bazar

[Install]
WantedBy=multi-user.target
