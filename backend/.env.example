# Backend env. Copy to backend/.env (local, read by scripts/dev.sh and start.sh)
# or /opt/bazar/.env (VPS, read by systemd). Never commit the real file.

# AI assistant (InferHub, OpenAI-style API). Empty key = assistant hidden in the app.
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://api.inferhub.dev/v1
INFERHUB_MODEL=cb/deepseek-v4.1-flash
# INFERHUB_TIMEOUT_SECONDS=90
# Reasoning mode: disabled (default, fastest) | enabled | default
# INFERHUB_THINKING=disabled
# Set to false if the model cannot read photos.
# INFERHUB_SUPPORTS_IMAGES=true
